# See devguide/LocalDevelopment.md if ports 5432 / 5000 / 8080 are already in use.
#
# Full stack (`make up-local`): compose overrides DB_HOST to `postgres` inside the API container and
# sets SERVER_PORT=5000 there; the host port is still this SERVER_PORT mapping.
SERVER_PORT=5000
ENVIRONMENT=local
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASS=postgres
DB_FORWARD_PORT=5432

SENTRY_DSN=

MAX_MULTIPART_MEMORY=10485760

ADMINER_PORT=8080

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

JWT_SECRET=replace-with-a-long-random-secret-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_PICK_TENANT_TTL_MINUTES=10

# Email verification & onboarding (defaults match application if omitted)
EMAIL_VERIFICATION_TTL_MINUTES=15
PUBLIC_APP_URL=http://localhost:3000
EMAIL_VERIFICATION_PATH=/verify
TENANT_INVITE_PATH=/accept-invite
TENANT_INVITE_TTL_MINUTES=10080

DEBUG_PORT=5002

TIMEZONE=UTC
